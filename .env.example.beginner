# Lean direct-access example for local or LAN testing.

BASE_URL=http://127.0.0.1:8000 # Change to the server IP address or hostname
# Direct-request mode: reflect the host the browser used. Best for localhost or LAN use.
PUBLIC_ORIGIN_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_REDIS_FAIL_CLOSED=false

DATABASE_URL=postgresql://imghost:imghost@localhost:5432/imghost
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-app-secret
ALLOW_REGISTRATION=true

# Add an existing username to promote to admin for recovery/bootstrap. Leave blank to disable.
PROMOTE_USERNAME_TO_ADMIN=
