# Docker/Compose deployment settings.
# This file is a hardened deployment-oriented example, not a direct-http localhost quick-start.

# Host port exposed for the web app container.
PORT=8000
APP_IMAGE=ghcr.io/jamesyc/imghost
APP_IMAGE_TAG=latest
# Canonical fallback public URL used when request-derived origin data is absent, malformed, or rejected.
BASE_URL=https://imghost.example.com
# Strict public-origin mode for real deployments behind a reverse proxy.
# Generated links, OAuth callbacks, ShareX config, and browser-session origin checks
# only trust configured public origins when this is enabled.
PUBLIC_ORIGIN_ENABLED=true
# Exact allowlist of browser-visible public origins that may appear in generated links.
TRUSTED_PUBLIC_ORIGINS=https://imghost.example.com,https://imghost.example2.com
# When true, only peers in TRUSTED_PROXY_CIDRS may influence X-Forwarded-* handling.
# Enable this when nginx, Caddy, Traefik, or Cloudflare sits in front of imghost.
TRUSTED_PROXY_CIDRS_ENABLED=true
# Immediate proxy/source CIDRs trusted to supply forwarded headers when the gate is enabled.
# List the proxy peers that connect directly to imghost, not end-user IPs.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# Secret used for signing browser-session cookies and other app secrets.
SECRET_KEY=change-me-secret-key
# Set to false to disable user registration
ALLOW_REGISTRATION=true
# Add an existing username to promote to admin for recovery/bootstrap. Leave blank to disable.
PROMOTE_USERNAME_TO_ADMIN=
# Optional Google sign-in. In Google Cloud Console use a Web application client,
# leave Authorized JavaScript origins blank, and set the redirect URI to
# https://your-domain.example/auth/google/callback.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis service port and app-facing Redis settings.
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-redis-password
REDIS_MODE=auto
REDIS_PREFIX=imghost

# Browser-session cookie settings.
SESSION_COOKIE_NAME=imghost_session
SESSION_COOKIE_SECURE=true
SESSION_REDIS_FAIL_CLOSED=true
SESSION_REMEMBER_DAYS=30

# Storage backend selection and in-container data path.
STORAGE_BACKEND=garage
IMGHOST_DATA_DIR=/app/data

# Postgres service settings used to derive DATABASE_URL inside Compose.
POSTGRES_DB=imghost
POSTGRES_USER=imghost
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_CONNECT_PORT=5432
DATABASE_USE_PGBOUNCER=true
PGBOUNCER_PORT=6432
PGBOUNCER_EXPOSE_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Garage cluster/bootstrap settings used by the Garage services and init job.
GARAGE_RPC_SECRET=change-me-64-hex-or-long-random-string
GARAGE_ADMIN_TOKEN=change-me-garage-admin-token
GARAGE_METRICS_TOKEN=change-me-garage-metrics-token
GARAGE_ZONE=dc1
GARAGE_CAPACITY=1G
GARAGE_KEY_NAME=imghost-app
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

# Garage / S3-compatible object storage settings consumed by the app.
S3_ENDPOINT_URL=http://garage:3900
S3_ACCESS_KEY_ID=GK0123456789abcdeffedcba01
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=imghost
S3_REGION=garage

# Upload, media-processing, and quota limits.
MAX_UPLOAD_BYTES=52428800
ANON_EXPIRY_HOURS=24
MAX_PIXEL_MEGAPIXELS=50
DEFAULT_USER_QUOTA_BYTES=2147483648
SERVER_QUOTA_BYTES=0
VIDEO_THUMB_FRAMES=10

# Background task queue and worker behavior.
# Keep TASK_WORKER_ENABLED=false in the app service and true in dedicated worker
# services. TASK_WORKER_QUEUES mainly matters if you run the generic
# `python -m imghost run-worker` command yourself. The scheduler service uses
# `python -m imghost run-scheduler`. The scheduler lease is Redis-only and is
# mainly for avoiding duplicate enqueueing when more than one scheduler runs.
TASK_QUEUE_MODE=redis
TASK_WORKER_ENABLED=true
TASK_WORKER_QUEUES=default,thumbnails,cleanup
THUMBNAIL_WORKER_COUNT=1
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_LEASE_SECONDS=900
CLEANUP_INTERVAL_SECONDS=900
