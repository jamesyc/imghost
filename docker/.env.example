# Docker/Compose infrastructure settings.

PORT=8000
BASE_URL=https://imghost.jamesyc.com
TRUSTED_PUBLIC_ORIGINS=https://imghost.jamesyc.com
SECRET_KEY=change-me-secret-key
REDIS_URL=redis://redis:6379/0
REDIS_MODE=auto
REDIS_PREFIX=imghost

STORAGE_BACKEND=garage
IMGHOST_DATA_DIR=/app/data

POSTGRES_DB=imghost
POSTGRES_USER=imghost
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_CONNECT_PORT=5432

GARAGE_RPC_SECRET=change-me-64-hex-or-long-random-string
GARAGE_ADMIN_TOKEN=change-me-garage-admin-token
GARAGE_METRICS_TOKEN=change-me-garage-metrics-token
GARAGE_ZONE=dc1
GARAGE_CAPACITY=1G
GARAGE_KEY_NAME=imghost-app
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

S3_ACCESS_KEY_ID=GK0123456789abcdeffedcba01
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=imghost
S3_REGION=garage
S3_ENDPOINT_URL=http://garage:3900

MAX_UPLOAD_BYTES=52428800
ANON_EXPIRY_HOURS=24
DEFAULT_USER_QUOTA_BYTES=2147483648
SERVER_QUOTA_BYTES=0
TASK_QUEUE_MODE=redis
