# Lean direct-access Docker example for local or LAN testing.

PORT=8000
BASE_URL=http://192.168.0.100:8000 # Change to the server IP address or hostname

# Direct-request mode: reflect the host the browser used. Best for localhost or LAN use.
PUBLIC_ORIGIN_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_REDIS_FAIL_CLOSED=false

SECRET_KEY=change-me-secret-key
POSTGRES_DB=imghost
POSTGRES_USER=imghost
POSTGRES_PASSWORD=change-me-postgres
REDIS_MODE=disabled
TASK_QUEUE_MODE=async
S3_ACCESS_KEY_ID=GK0123456789abcdeffedcba01
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=imghost

# Set to false to disable user registration
ALLOW_REGISTRATION=true
# Add an existing username to promote to admin for recovery/bootstrap. Leave blank to disable.
PROMOTE_USERNAME_TO_ADMIN=
